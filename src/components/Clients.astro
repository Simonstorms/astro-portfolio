---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import hertha from "../assets/clients/hertha-bsc.svg";
import w3work from "../assets/clients/w3work.svg";
import tzDresden from "../assets/clients/tz-dresden.png";
import playTheHype from "../assets/clients/playthehype.png";
import berlinAufDie1 from "../assets/clients/berlin-auf-die-1.png";

interface Client {
    name: string;
    href: string;
    logo: ImageMetadata;
    height?: number;
}

const clients: Client[] = [
    { name: "w3work", href: "https://www.w3work.de", logo: w3work },
    {
        name: "TechnologieZentrumDresden",
        href: "https://tzdresden.de",
        logo: tzDresden,
        height: 32,
    },
    {
        name: "Hertha BSC",
        href: "https://www.herthabsc.com",
        logo: hertha,
        height: 36,
    },
    {
        name: "PlayTheHype",
        href: "https://www.playthehype.com",
        logo: playTheHype,
    },
    {
        name: "Berlin auf die 1",
        href: "https://berlinaufdieeins.de",
        logo: berlinAufDie1,
        height: 32,
    },
];
---

<section class="clients" aria-label="Clients">
    <p class="clients-label">Worked with</p>
    <ul class="clients-list">
        {
            clients.map((client) => (
                <li>
                    <a
                        href={client.href}
                        target="_blank"
                        rel="noopener"
                        class="client-link"
                        title={client.name}
                    >
                        <Image
                            src={client.logo}
                            alt={client.name}
                            class="client-logo"
                            height={144}
                            loading="lazy"
                            style={`--logo-height: ${client.height ?? 28}px`}
                        />
                    </a>
                </li>
            ))
        }
    </ul>
</section>

<style>
    .clients {
        padding-top: 32px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
    }

    .clients-label {
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #999;
    }

    .clients-list {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 14px 32px;
    }

    .client-link {
        display: flex;
        align-items: center;
        justify-content: center;
        filter: grayscale(1);
        opacity: 0.5;
        transition:
            filter 0.2s,
            opacity 0.2s;
    }

    .client-link:hover {
        filter: grayscale(0);
        opacity: 1;
    }

    .client-logo {
        display: block;
        width: auto;
        height: var(--logo-height);
    }

    @media (max-width: 640px) {
        .clients-list {
            gap: 16px 24px;
        }

        .client-logo {
            height: calc(var(--logo-height) * 0.85);
        }
    }
</style>
